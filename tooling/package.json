{
	"name": "@reactive-resume/tooling",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"db:reset": "tsx database/reset.ts",
		"docs:gen": "tsx semantic-css/generate-reference.ts",
		"test": "vp test run --passWithNoTests",
		"test:documents": "vp test run --config vitest.documents.config.ts",
		"test:ci": "vp test run --reporter=default --reporter=github-actions --reporter=json --reporter=junit --outputFile.json=reports/vitest-results.json --outputFile.junit=reports/vitest-junit.xml --passWithNoTests",
		"typecheck": "tsrs --noEmit",
		"pdf:translations": "tsx locales/generate.ts",
		"icons:pdf": "tsx icons/phosphor-pdf.ts"
	},
	"dependencies": {
		"@reactive-resume/schema": "workspace:*"
	},
	"devDependencies": {
		"node-html-parser": "9.0.6",
		"@lingui/format-po": "^6.12.0",
		"@phosphor-icons/react": "^2.1.10",
		"@reactive-resume/config": "workspace:*",
		"@reactive-resume/env": "workspace:*",
		"@reactive-resume/resume": "workspace:*",
		"@types/pg": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"drizzle-orm": "catalog:",
		"esbuild": "catalog:",
		"pg": "catalog:",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tsrs": "catalog:",
		"tsx": "^4.23.15",
		"vite-plus": "catalog:",
		"wrangler": "catalog:",
		"@reactive-resume/pdf": "workspace:*",
		"@reactive-resume/import": "workspace:*",
		"pdfjs-dist": "6.5.438",
		"zod": "catalog:"
	}
}
