{
	"name": "@reactive-resume/tooling",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"review:evaluate:synthetic": "tsx evaluations/review/run-synthetic.ts",
		"copy:check": "tsx locales/check-copy.ts",
		"copy:check:bindings": "tsx locales/check-copy.ts --bindings",
		"copy:generate:auth-mail": "tsx locales/generate-auth-mail.ts",
		"copy:generate:workspace": "tsx locales/generate-workspace-copy.ts",
		"copy:sync:workspace": "tsx locales/sync-workspace-catalogs.ts",
		"db:reset": "tsx database/reset.ts",
		"docs:gen": "tsx semantic-css/generate-reference.ts",
		"test": "vp test run --passWithNoTests",
		"test:documents": "vp test run --config vitest.documents.config.ts",
		"test:ci": "vp test run --reporter=default --reporter=github-actions --reporter=json --reporter=junit --outputFile.json=reports/vitest-results.json --outputFile.junit=reports/vitest-junit.xml --passWithNoTests",
		"typecheck": "tsrs --noEmit",
		"pdf:translations": "tsx locales/generate.ts",
		"icons:pdf": "tsx icons/phosphor-pdf.ts",
		"eval:review": "tsx evaluations/review/cli.ts",
		"eval:review:replay": "node --import tsx evaluations/review/fairness-replay-cli.ts",
		"eval:review:repair": "tsx evaluations/review/repair-cli.ts",
		"eval:review:rescore": "node --import tsx evaluations/review/rescore-cli.ts",
		"eval:review:lexical-lost-fact-replay": "node --import tsx evaluations/review/lexical-lost-fact-replay-cli.ts",
		"eval:review:owner-review": "node --import tsx evaluations/review/owner-review-cli.ts",
		"eval:review:safety-replay": "node --import tsx evaluations/review/safety-replay-cli.ts",
		"eval:review:reguard": "node --import tsx evaluations/review/reguard-cli.ts"
	},
	"dependencies": {
		"@reactive-resume/schema": "workspace:*"
	},
	"devDependencies": {
		"@lingui/core": "catalog:",
		"@lingui/format-po": "^6.10.0",
		"@lingui/message-utils": "catalog:",
		"@phosphor-icons/react": "^2.1.10",
		"@playwright/test": "^1.64.1",
		"@reactive-resume/api": "workspace:*",
		"@reactive-resume/config": "workspace:*",
		"@reactive-resume/env": "workspace:*",
		"@reactive-resume/import": "workspace:*",
		"@reactive-resume/pdf": "workspace:*",
		"@reactive-resume/resume": "workspace:*",
		"@types/pg": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"drizzle-orm": "catalog:",
		"esbuild": "catalog:",
		"happy-dom": "^21.0.4",
		"node-html-parser": "9.0.5",
		"pdfjs-dist": "6.4.299",
		"pg": "catalog:",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tsrs": "catalog:",
		"tsx": "^4.23.15",
		"typescript": "catalog:",
		"vite-plus": "catalog:",
		"wrangler": "catalog:",
		"zod": "catalog:"
	}
}
