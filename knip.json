{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"tags": ["-lintignore"],
	"ignoreBinaries": ["pdftotext", "pdftoppm", "gitleaks", "dpkg-deb"],
	"workspaces": {
		"apps/mobile": {
			"ignoreExportsUsedInFile": true,
			"ignoreIssues": {
				"src/ui/overlays.tsx": ["duplicates"]
			},
			"entry": [
				"fingerprint.config.js",
				"lingui.config.ts",
				"scripts/**/*.{mjs,mts,tsx}",
				"src/features/licences/generate.cjs",
				"src/draft/index.ts",
				"src/features/applications/stages.ts",
				"src/features/assistant/chat-view.tsx",
				"src/features/workspace/hooks.ts",
				"src/features/write/{fields,rich-text}.ts",
				"src/features/write/outline.tsx",
				"src/ui/{index,tokens}.ts"
			]
		},
		"apps/web": {
			"entry": [
				"lingui.config.ts",
				"vitest.config.ts",
				"src/features/homepage/prerender.tsx",
				"src/features/ats-checker/checker.tsx",
				"src/features/ats-checker/pending-import.ts",
				"src/features/resume/builder/password-dialog.tsx",
				"src/features/resume/editor/check/job-match.tsx",
				"src/features/resume/editor/check/review.ts",
				"src/features/resume/share/link-tab.tsx",
				"src/features/settings/integrations/components/ai-provider-picker.tsx",
				"src/routes/builder/$resumeId/-components/document-details.tsx",
				"src/routes/builder/$resumeId/-sidebar/right/sections/notes.tsx",
				"src/features/resume/editor/proposals/proposal-list.tsx"
			],
			"vite": {
				"config": []
			},
			"vitest": {
				"config": []
			},
			"ignoreDependencies": ["@reactive-resume/docx"]
		},
		"apps/server": {
			"entry": ["vercel.mjs", "src/cloudflare/index.ts", "src/cloudflare/sharp.ts"],
			"ignoreDependencies": [
				"@ai-sdk/anthropic",
				"@ai-sdk/cerebras",
				"@ai-sdk/cohere",
				"@ai-sdk/deepseek",
				"@ai-sdk/fireworks",
				"@ai-sdk/google",
				"@ai-sdk/groq",
				"@ai-sdk/mistral",
				"@ai-sdk/openai",
				"@ai-sdk/openai-compatible",
				"@ai-sdk/perplexity",
				"@ai-sdk/togetherai",
				"@ai-sdk/xai",
				"@aws-sdk/client-s3",
				"@better-auth/api-key",
				"@better-auth/drizzle-adapter",
				"@better-auth/infra",
				"@better-auth/passkey",
				"@bramus/specificity",
				"@formepdf/react",
				"@orpc/experimental-ratelimit",
				"@sindresorhus/slugify",
				"@t3-oss/env-core",
				"@uiw/color-convert",
				"@vercel/blob",
				"ai",
				"bcryptjs",
				"cjk-regex",
				"css-tree",
				"docx",
				"drizzle-zod",
				"fast-json-patch",
				"fast-png",
				"fflate",
				"ioredis",
				"jose",
				"jsonrepair",
				"node-html-parser",
				"nodemailer",
				"ollama-ai-provider-v2",
				"pdfjs-dist",
				"react-email",
				"react-reconciler",
				"resumable-stream",
				"sanitize-html",
				"tokenx",
				"ts-pattern",
				"unique-names-generator",
				"uuid"
			]
		},
		"tooling": {
			"entry": ["**/*.mjs", "mcp/seed.ts", "vitest.documents.config.ts", "document-qualification/run.qualification.ts"],
			"ignoreDependencies": ["@formepdf/core", "@orpc/client", "css-tree"]
		},
		"packages/api": {
			"ignoreDependencies": ["ioredis"]
		}
	}
}
