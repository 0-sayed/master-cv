# Fill required values before first start. Remove optional entries that remain empty.
APP_URL=https://sirawise.io
DATABASE_MIGRATION_URL=postgresql://sirawise:<POSTGRES_PASSWORD>@postgres:5432/sirawise
DATABASE_URL=postgresql://sirawise_runtime:<RUNTIME_DB_PASSWORD>@postgres:5432/sirawise
AUTH_SECRET=
ENCRYPTION_SECRET=
DEPLOYMENT_NAMESPACE=sirawise
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/data
FLAG_DISABLE_SIGNUPS=false
ADMIN_EMAILS=

# Both database connections use host postgres inside the Compose network.
# Write the passwords literally in both URLs; this file is not interpolated.
# POSTGRES_USER owns the schema and supplies DATABASE_MIGRATION_URL.
POSTGRES_PASSWORD=
RUNTIME_DB_PASSWORD=

# Google sign-in stays disabled until both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend SMTP. Set the credentials before users sign up.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
